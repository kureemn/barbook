# Copy this file to .env.local and fill in the values from the Neon Console
# (your project -> Postgres database -> Data API). Never commit .env.local.

# Public: safe in the browser, because Row Level Security decides what they can reach.
NEXT_PUBLIC_NEON_AUTH_URL=
NEXT_PUBLIC_NEON_DATA_API_URL=

# Server-only secret: used only by `npm run db:migrate` on your own machine.
# Never give it a NEXT_PUBLIC_ prefix, and never add it to Vercel.
DATABASE_URL=
